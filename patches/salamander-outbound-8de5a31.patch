--- /dev/null
+++ b/dialer/hysteria2/hysteria2_url_test.go
@@ -0,0 +1,51 @@
+package hysteria2
+
+import "testing"
+
+func TestParseHysteria2URL_Obfs(t *testing.T) {
+	// Standard URI-scheme format (matches the common subscription format).
+	link := "hysteria2://user:pass@example.com:443/?obfs=salamander&obfs-password=cry_me_a_r1ver&sni=example.com#node"
+	s, err := ParseHysteria2URL(link)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if s.Obfs != "salamander" {
+		t.Fatalf("Obfs = %q, want salamander", s.Obfs)
+	}
+	if s.ObfsPassword != "cry_me_a_r1ver" {
+		t.Fatalf("ObfsPassword = %q", s.ObfsPassword)
+	}
+
+	// Export must round-trip the obfs parameters back.
+	out, err := ParseHysteria2URL(s.ExportToURL())
+	if err != nil {
+		t.Fatalf("re-parse exported URL: %v", err)
+	}
+	if out.Obfs != "salamander" || out.ObfsPassword != "cry_me_a_r1ver" {
+		t.Fatalf("round trip lost obfs: %+v", out)
+	}
+}
+
+func TestParseHysteria2URL_NoObfs(t *testing.T) {
+	s, err := ParseHysteria2URL("hysteria2://user:pass@example.com:443/#node")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if s.Obfs != "" || s.ObfsPassword != "" {
+		t.Fatalf("expected no obfs, got %+v", s)
+	}
+}
+
+func TestParseHysteria2URL_SalamanderMissingPassword(t *testing.T) {
+	_, err := ParseHysteria2URL("hysteria2://user:pass@example.com:443/?obfs=salamander#node")
+	if err == nil {
+		t.Fatal("expected error when obfs=salamander but no password")
+	}
+}
+
+func TestParseHysteria2URL_UnsupportedObfs(t *testing.T) {
+	_, err := ParseHysteria2URL("hysteria2://user:pass@example.com:443/?obfs=xor&obfs-password=x#node")
+	if err == nil {
+		t.Fatal("expected error for unsupported obfs type")
+	}
+}
